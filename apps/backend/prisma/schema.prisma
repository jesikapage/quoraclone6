generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")
}

enum NotificationType {
  LIKE    @map("like")
  COMMENT @map("comment")
  FOLLOW  @map("follow")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────
model User {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  name              String    @db.VarChar(255)
  username          String    @unique @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  password          String?   @db.VarChar(255)
  avatar_url        String?   @db.Text
  bio               String?   @db.Text
  provider          AuthProvider @default(EMAIL)
  provider_id       String?   @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(6)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @updatedAt @db.Timestamp(6)

  // Relations
  posts               Post[]
  comments            Comment[]
  post_likes          PostLike[]
  notifications       Notification[] @relation("NotificationRecipient")
  acted_notifications Notification[] @relation("NotificationActor")

  @@map("users")
}

// ─────────────────────────────────────────
// POSTS
// ─────────────────────────────────────────
model Post {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  user_id    BigInt   @db.BigInt
  content    String   @db.Text
  image_url  String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  // Relations
  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comments      Comment[]
  post_likes    PostLike[]
  notifications Notification[]

  @@index([user_id])
  @@map("posts")
}

// ─────────────────────────────────────────
// POST LIKES
// ─────────────────────────────────────────
model PostLike {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  post_id    BigInt   @db.BigInt
  user_id    BigInt   @db.BigInt
  created_at DateTime @default(now()) @db.Timestamp(6)

  // Relations
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id]) // Prevent duplicate likes
  @@index([user_id])
  @@map("post_likes")
}

// ─────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────
model Comment {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  post_id           BigInt   @db.BigInt
  user_id           BigInt   @db.BigInt
  parent_comment_id BigInt?  @db.BigInt
  content           String   @db.Text
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  // Relations
  post           Post           @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent_comment Comment?       @relation("CommentReplies", fields: [parent_comment_id], references: [id], onDelete: SetNull)
  replies        Comment[]      @relation("CommentReplies")
  notifications  Notification[]

  @@index([post_id])
  @@index([user_id])
  @@index([parent_comment_id])
  @@map("comments")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────
model Notification {
  id         BigInt           @id @default(autoincrement()) @db.BigInt
  user_id    BigInt           @db.BigInt
  actor_id   BigInt           @db.BigInt
  type       NotificationType
  post_id    BigInt?          @db.BigInt
  comment_id BigInt?          @db.BigInt
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now()) @db.Timestamp(6)

  // Relations
  user    User     @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  actor   User     @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [post_id], references: [id], onDelete: SetNull)
  comment Comment? @relation(fields: [comment_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([actor_id])
  @@index([post_id])
  @@index([comment_id])
  @@map("notifications")
}